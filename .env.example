# Copy to .env and fill in. Launch_Luna.command loads it. Never commit your .env.
# Live Japanese conversation needs a realtime voice API that speaks the same
# session protocol the companion uses (see japanese_session.py).

# Base address of your provider's API, without a trailing slash.
LUNA_API_BASE=
# Your API key. You can also paste it into Settings in the Loft instead.
LUNA_API_KEY=

# Realtime voice model for "Talk with Luna", and an optional fallback.
LUNA_LIVE_MODEL=
LUNA_LIVE_FALLBACK_MODEL=
# Optional: a text model the tutor can consult for grammar questions, and a voice name.
LUNA_TUTOR_MODEL=
LUNA_VOICE=

# Only for the retired voice-note feature.
LUNA_TRANSCRIBE_MODEL=
LUNA_DIRECTOR_MODEL=
